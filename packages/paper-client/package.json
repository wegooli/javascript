{
  "name": "@wegooli/paper-client",
  "version": "0.2.0",
  "description": "계약서 양식 서버에 말하고 자격(위임 토큰 또는 서비스 열쇠)을 붙입니다. 화면은 그리지 않습니다.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wegooli/javascript.git",
    "directory": "packages/paper-client"
  },
  "homepage": "https://github.com/wegooli/javascript/tree/main/packages/paper-client#readme",
  "bugs": "https://github.com/wegooli/javascript/issues",
  "keywords": [
    "paper",
    "template",
    "contract",
    "typescript"
  ]
}
