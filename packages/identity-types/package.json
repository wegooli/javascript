{
  "name": "@wegooli/identity-types",
  "version": "1.0.7",
  "description": "\uacf5\uc720 TypeScript \ud0c0\uc785 \u2014 JWT \ud074\ub808\uc784, API \uc751\ub2f5, ERD \uc5d4\ud2f0\ud2f0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wegooli/javascript.git",
    "directory": "packages/identity-types"
  },
  "homepage": "https://github.com/wegooli/javascript/tree/main/packages/identity-types#readme",
  "bugs": "https://github.com/wegooli/javascript/issues",
  "keywords": [
    "identity",
    "auth",
    "authentication",
    "oidc",
    "types",
    "typescript"
  ]
}
